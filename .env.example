# Copy to .env (git-ignored) to override the docker compose defaults.

# Database created by the postgres service. The password goes into DATABASE_URL as is,
# so keep it URL-safe (letters, digits, - _ . ~).
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat

# Host port for the API.
API_PORT=3000

# Server settings (see README "Configuration").
LOG_LEVEL=info
PROVIDERS_ENABLED=demo
DEFAULT_PROVIDER=demo
# Empty: the default provider's own default model.
DEFAULT_MODEL=
# Empty: no system prompt for sessions without their own.
DEFAULT_SYSTEM_PROMPT=
FLUSH_INTERVAL_MS=1000
DEMO_DELAY_MS=50
