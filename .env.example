# Copy to .env (git-ignored) to override the docker compose defaults.

# Database created by the postgres service. The password goes into DATABASE_URL as is,
# so keep it URL-safe (letters, digits, - _ . ~).
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat

# Host port for the API.
API_PORT=3000

# Server settings (see README "Configuration").
LOG_LEVEL=info
PROVIDERS_ENABLED=demo
DEFAULT_PROVIDER=demo
# Empty: the default provider's own default model.
DEFAULT_MODEL=
# Empty: no system prompt for sessions without their own.
DEFAULT_SYSTEM_PROMPT=
FLUSH_INTERVAL_MS=1000
DEMO_DELAY_MS=50
# How long a JSON send waits for its answer (Prefer: wait=N may ask for up to the maximum).
JSON_DEFAULT_WAIT_MS=30000
JSON_MAX_WAIT_MS=195000
# Generation deadline and crash recovery (see README "Failure handling"). A generating row is
# failed as interrupted once deadline + terminal-write budget + grace have passed (240 s);
# graceful shutdown takes up to statement timeout + terminal-write budget + 5 s (18 s).
GENERATION_DEADLINE_MS=180000
TERMINAL_STATEMENT_TIMEOUT_MS=3000
TERMINAL_WRITE_BUDGET_MS=10000
RECLAIM_GRACE_MS=50000
# Capacity (see README "Limits"): active answers in this process, and per provider
# unless the catalog sets the provider's maxConcurrency. Beyond them a send gets 503.
MAX_ACTIVE_GENERATIONS=8
MAX_ACTIVE_PER_PROVIDER=4
# Event streams (see README "Streaming"): a ping comment for quiet streams, and the bytes a
# slow client may leave unread before its connection is closed.
SSE_PING_INTERVAL_MS=15000
SSE_BUFFER_LIMIT_BYTES=262144
# Abuse protection (see README "Security considerations"): requests a minute per client
# address to every route but the health checks, and sends a minute on top of that. A client
# gets this long to send a whole request (then 408); one database statement gets this long.
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_SEND_PER_MIN=20
REQUEST_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
# Comma-separated IPs or CIDR ranges of proxies whose X-Forwarded-For is believed, such as
# 10.0.0.0/8. Empty: the socket's address counts, so all clients behind one proxy share a budget.
TRUST_PROXY=
# Origins whose browser scripts may read responses (http(s) origins, or *). Empty: no CORS.
CORS_ORIGINS=
# Data retention (see README "Data retention"): sessions inactive for this many days are
# deleted, checked every interval. Empty: nothing is ever deleted.
RETENTION_DAYS=
RETENTION_INTERVAL_MS=3600000
# Hosted provider (add nvidia to PROVIDERS_ENABLED). Without NVIDIA_API_KEY every request
# must bring its own key in the X-LLM-Api-Key header. Never commit a real key.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Local model (see README "Local model (Ollama)"): docker compose --env-file local-llm.env up
# turns on the local-llm profile and adds ollama to PROVIDERS_ENABLED. Keyless. Compose points
# the api at its ollama service; set this only for an Ollama elsewhere.
# OLLAMA_BASE_URL=http://ollama:11434/v1
