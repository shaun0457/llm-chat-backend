{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "passThroughEnv": [
        "PORT",
        "HOST",
        "LOG_LEVEL",
        "NODE_ENV",
        "DATABASE_URL",
        "MODEL_CATALOG_PATH",
        "PROVIDERS_ENABLED",
        "DEFAULT_PROVIDER",
        "DEFAULT_MODEL"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "LOG_LEVEL",
        "NODE_ENV",
        "DATABASE_URL",
        "MODEL_CATALOG_PATH",
        "PROVIDERS_ENABLED",
        "DEFAULT_PROVIDER",
        "DEFAULT_MODEL"
      ]
    },
    "format": {},
    "lint": {},
    "lint:ci": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "test:unit": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
